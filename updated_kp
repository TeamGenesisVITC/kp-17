void disableServo(
  uint8_t servo
) {

  pwm.setPin(
    servo,
    0
  );


  commandedAngle[servo] =
    -1;


  Serial.printf(
    "Servo %u disabled.\n",
    servo
  );
}


// ============================================================
// DISABLE ALL SERVOS
// ============================================================

void disableAllServos() {

  for (
    uint8_t servo = 0;
    servo < SERVO_COUNT;
    servo++
  ) {

    pwm.setPin(
      servo,
      0
    );


    commandedAngle[servo] =
      -1;
  }


  Serial.println(
    "All servos disabled."
  );
}


