// ============================================================
// PARSE INTEGER
// ============================================================

bool parseInteger(
  const String& text,
  int& result
) {

  if (
    text.length() == 0
  ) {

    return false;
  }


  char* endPointer =
    nullptr;


  const long value =
    strtol(
      text.c_str(),
      &endPointer,
      10
    );


  if (
    *endPointer != '\0'
  ) {

    return false;
  }


  result =
    static_cast<int>(
      value
    );


  return true;
}


// ============================================================
// PROCESS COMMAND
// ============================================================

void processCommand(
  String command
) {

  command.trim();

  command.toLowerCase();


  if (
    command.length() == 0
  ) {

    return;
  }


  // ==========================================================
  // SEQUENTIAL STATE
  // q
  // ==========================================================

  if (
    command == "q"
  ) {

    waitingForServoNumber =
      false;


    sequentialState();

    return;
  }


  // ==========================================================
  // RIGHT LEG
  // r
  // ==========================================================

  if (
    command == "r"
  ) {

    waitingForServoNumber =
      false;


    rightLegStep();

    return;
  }


  // ==========================================================
  // LEFT LEG
  // l
  // ==========================================================

  if (
    command == "l"
  ) {

    waitingForServoNumber =
      false;


    leftLegStep();

    return;
  }


  // ==========================================================
  // WALK
  // w
  // ==========================================================

  if (
    command == "w"
  ) {

    waitingForServoNumber =
      false;


    walk();

    return;
  }


  // ==========================================================
  // DEFAULT
  // d
  // ==========================================================

  if (
    command == "d"
  ) {

    waitingForServoNumber =
      false;


    goToDefaultPose();

    return;
  }


  // ==========================================================
  // WAITING FOR SERVO NUMBER
  // ==========================================================

  if (
    waitingForServoNumber
  ) {

    int servoNumber;


    if (
      !parseInteger(
        command,
        servoNumber
      )
      ||
      servoNumber < 0
      ||
      servoNumber >= SERVO_COUNT
    ) {

      Serial.println(
        "Enter a servo number from 0 to 9."
      );

      return;
    }


    selectedServo =
      servoNumber;


    waitingForServoNumber =
      false;


    Serial.printf(
      "Selected servo %d.\n",
      selectedServo
    );


    Serial.println(
      "Enter an angle from 0 to 180."
    );


    return;
  }


  // ==========================================================
  // SELECT SERVO
  // sel
  // ==========================================================

  if (
    command == "sel"
  ) {

    waitingForServoNumber =
      true;


    Serial.println(
      "Enter servo number 0 to 9."
    );


    return;
  }


  // ==========================================================
  // SELECT SERVO DIRECTLY
  //
  // Example:
  // sel 4
  // ==========================================================

  if (
    command.startsWith("sel ")
  ) {

    String servoText =
      command.substring(4);


    servoText.trim();


    int servoNumber;


    if (
      !parseInteger(
        servoText,
        servoNumber
      )
      ||
      servoNumber < 0
      ||
      servoNumber >= SERVO_COUNT
    ) {

      Serial.println(
        "Servo number must be from 0 to 9."
      );


      return;
    }


    selectedServo =
      servoNumber;


    Serial.printf(
      "Selected servo %d.\n",
      selectedServo
    );


    Serial.println(
      "Enter an angle from 0 to 180."
    );


    return;
  }


  // ==========================================================
  // PRINT POSE
  // p
  // ==========================================================

  if (
    command == "p"
  ) {

    printPose();

    return;
  }


  // ==========================================================
  // DISABLE SELECTED SERVO
  // x
  // ==========================================================

  if (
    command == "x"
  ) {

    disableServo(
      selectedServo
    );


    return;
  }


  // ==========================================================
  // DISABLE ALL
  // xa
  // ==========================================================

  if (
    command == "xa"
  ) {

    disableAllServos();

    return;
  }


  // ==========================================================
  // HELP
  // h
  // ==========================================================

  if (
    command == "h"
  ) {

    printHelp();

    return;
  }


  // ==========================================================
  // ANGLE COMMAND
  // ==========================================================

  int angle;


  if (
    !parseInteger(
      command,
      angle
    )
    ||
    angle < 0
    ||
    angle > 180
  ) {

    Serial.println(
      "Invalid command."
    );

    Serial.println(
      "Type h for help."
    );


    return;
  }


  // ----------------------------------------------------------
  // Move selected servo
  // ----------------------------------------------------------

  moveServo(
    selectedServo,
    angle
  );
}


// ============================================================
// SETUP
// ============================================================

void setup() {

  Serial.begin(
    115200
  );


  delay(500);


  // ----------------------------------------------------------
  // Initialize positions
  // ----------------------------------------------------------

  for (
    uint8_t servo = 0;
    servo < SERVO_COUNT;
    servo++
  ) {

    commandedAngle[servo] =
      -1;
  }


  // ----------------------------------------------------------
  // Start I2C
  // ----------------------------------------------------------

  if (
    !Wire.begin(
      SDA_PIN,
      SCL_PIN,
      400000
    )
  ) {

    Serial.println(
      "ERROR: Could not start I2C."
    );


    while (true) {

      delay(1000);
    }
  }


  // ----------------------------------------------------------
  // Start PCA9685
  // ----------------------------------------------------------

  if (
    !pwm.begin()
  ) {

    Serial.println(
      "ERROR: PCA9685 not found."
    );


    while (true) {

      delay(1000);
    }
  }


  pwm.setPWMFreq(
    SERVO_FREQUENCY_HZ
  );


  delay(20);


  // ----------------------------------------------------------
  // Start with servos disabled
  // ----------------------------------------------------------

  disableAllServos();


  // ----------------------------------------------------------
  // Startup message
  // ----------------------------------------------------------

  Serial.println();

  Serial.println(
    "========================================"
  );

  Serial.println(
    "          KP17 GAIT CONTROLLER"
  );

  Serial.println(
    "========================================"
  );


  Serial.println();


  Serial.println(
    "Default pose:"
  );


  Serial.println(
    "42 120 45 80 90 100 90 135 50 60"
  );


  Serial.println();


  Serial.print(
    "Normal frame delay: "
  );

  Serial.print(
    GAIT_FRAME_DELAY_MS
  );

  Serial.println(
    " ms"
  );


  Serial.print(
    "Sequential delay: "
  );

  Serial.print(
    SEQUENTIAL_DELAY_MS
  );

  Serial.println(
    " ms"
  );


  printHelp();
}


