// ============================================================
// ANGLE -> PCA9685 TICKS
// ============================================================

uint16_t angleToTicks(int angle) {

  angle = constrain(angle, 0, 180);

  const uint16_t pulseUs = map(
    angle,
    0,
    180,
    SERVO_MIN_US,
    SERVO_MAX_US
  );

  return static_cast<uint32_t>(pulseUs)
         * 4096UL
         / 20000UL;
}


// ============================================================
// WRITE SERVO
// ============================================================

void writeServoAngle(
  uint8_t servo,
  int angle
) {

  angle = constrain(angle, 0, 180);

  pwm.setPWM(
    servo,
    0,
    angleToTicks(angle)
  );
}


// ============================================================
// MOVE ONE SERVO
// ============================================================

void moveServo(
  uint8_t servo,
  int targetAngle
) {

  targetAngle = constrain(
    targetAngle,
    0,
    180
  );


  // ----------------------------------------------------------
  // If servo has never been commanded
  // ----------------------------------------------------------

  if (commandedAngle[servo] < 0) {

    writeServoAngle(
      servo,
      targetAngle
    );

    commandedAngle[servo] =
      targetAngle;

    Serial.printf(
      "Servo %u commanded to %d degrees.\n",
      servo,
      targetAngle
    );

    return;
  }


  int currentAngle =
    commandedAngle[servo];


  // ----------------------------------------------------------
  // Move gradually
  // ----------------------------------------------------------

  while (
    currentAngle != targetAngle
  ) {

    if (
      currentAngle < targetAngle
    ) {

      currentAngle +=
        MOVE_STEP_DEGREES;

      if (
        currentAngle > targetAngle
      ) {

        currentAngle =
          targetAngle;
      }

    }
    else {

      currentAngle -=
        MOVE_STEP_DEGREES;

      if (
        currentAngle < targetAngle
      ) {

        currentAngle =
          targetAngle;
      }
    }


    writeServoAngle(
      servo,
      currentAngle
    );


    commandedAngle[servo] =
      currentAngle;


    delay(
      MOVE_STEP_DELAY_MS
    );
  }


  commandedAngle[servo] =
    targetAngle;


  Serial.printf(
    "Servo %u commanded to %d degrees.\n",
    servo,
    targetAngle
  );
}


// ============================================================
// MOVE ALL SERVOS TO POSE
// ============================================================

void moveToPose(
  const int targetPose[SERVO_COUNT],
  const char* frameName
) {

  Serial.println();
  Serial.println("----------------------------------------");

  Serial.print(
    "MOVING TO: "
  );

  Serial.println(
    frameName
  );

  Serial.println("----------------------------------------");


  int startAngle[SERVO_COUNT];


  // ----------------------------------------------------------
  // Determine starting positions
  // ----------------------------------------------------------

  for (
    uint8_t servo = 0;
    servo < SERVO_COUNT;
    servo++
  ) {

    if (
      commandedAngle[servo] < 0
    ) {

      startAngle[servo] =
        targetPose[servo];

    }
    else {

      startAngle[servo] =
        commandedAngle[servo];
    }
  }


  // ----------------------------------------------------------
  // Find largest movement
  // ----------------------------------------------------------

  int maxDifference = 0;


  for (
    uint8_t servo = 0;
    servo < SERVO_COUNT;
    servo++
  ) {

    int difference =
      abs(
        targetPose[servo]
        -
        startAngle[servo]
      );


    if (
      difference > maxDifference
    ) {

      maxDifference =
        difference;
    }
  }


  // ----------------------------------------------------------
  // Already at target
  // ----------------------------------------------------------

  if (
    maxDifference == 0
  ) {

    for (
      uint8_t servo = 0;
      servo < SERVO_COUNT;
      servo++
    ) {

      commandedAngle[servo] =
        targetPose[servo];

      writeServoAngle(
        servo,
        targetPose[servo]
      );
    }


    Serial.println(
      "Already at this frame."
    );


    delay(
      GAIT_FRAME_DELAY_MS
    );

    return;
  }


  // ----------------------------------------------------------
  // MOVE ALL SERVOS TOGETHER
  // ----------------------------------------------------------

  for (
    int step = 1;
    step <= maxDifference;
    step++
  ) {

    for (
      uint8_t servo = 0;
      servo < SERVO_COUNT;
      servo++
    ) {

      int difference =
        targetPose[servo]
        -
        startAngle[servo];


      int newAngle =
        startAngle[servo]
        +
        (
          difference * step
        )
        /
        maxDifference;


      newAngle =
        constrain(
          newAngle,
          0,
          180
        );


      writeServoAngle(
        servo,
        newAngle
      );


      commandedAngle[servo] =
        newAngle;
    }


    // Delay between every degree
    delay(
      MOVE_STEP_DELAY_MS
    );
  }


  // ----------------------------------------------------------
  // Ensure exact final values
  // ----------------------------------------------------------

  for (
    uint8_t servo = 0;
    servo < SERVO_COUNT;
    servo++
  ) {

    commandedAngle[servo] =
      targetPose[servo];

    writeServoAngle(
      servo,
      targetPose[servo]
    );
  }


  Serial.println(
    "Frame reached."
  );


  // ----------------------------------------------------------
  // SETTLING DELAY
  // ----------------------------------------------------------

  Serial.print(
    "Settling for "
  );

  Serial.print(
    GAIT_FRAME_DELAY_MS
  );

  Serial.println(
    " ms..."
  );


  delay(
    GAIT_FRAME_DELAY_MS
  );
}


