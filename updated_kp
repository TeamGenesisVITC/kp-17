// LOOP
// ============================================================

void loop() {

  while (
    Serial.available() > 0
  ) {

    const char character =
      Serial.read();


    // --------------------------------------------------------
    // Process when Enter is pressed
    // --------------------------------------------------------

    if (
      character == '\n' ||
      character == '\r'
    ) {

      if (
        inputLine.length() > 0
      ) {

        processCommand(
          inputLine
        );


        inputLine =
          "";
      }

    }
    else {

      inputLine +=  
        character;


      if (
        inputLine.length() > 32
      ) {

        inputLine =
          "";


        Serial.println(
          "Input too long."
        );
      }
    }
  }
}
