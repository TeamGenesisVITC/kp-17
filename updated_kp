        "not commanded"
      );

    }
    else {

      Serial.printf(
        "%d degrees\n",
        commandedAngle[servo]
      );
    }
  }


  Serial.println();

  Serial.print(
    "Copyable array: {"
  );


  for (
    uint8_t servo = 0;
    servo < SERVO_COUNT;
    servo++
  ) {

    if (
      commandedAngle[servo] < 0
    ) {

      Serial.print(
        "-1"
      );

    }
    else {

      Serial.print(
        commandedAngle[servo]
      );
    }


    if (
      servo < SERVO_COUNT - 1
    ) {

      Serial.print(
        ", "
      );
    }
  }


  Serial.println(
    "}"
  );

  Serial.println();
}


// ============================================================
